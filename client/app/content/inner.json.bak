       "type": "list",
       "items": [
        "Cash handling procedures",
        "Bank reconciliations",
        "Payment approvals",
        "Treasury controls"
       ]
      }
     ]
    },
    {
     "heading": "Financial Reporting",
     "blocks": [
      {
       "type": "list",
       "items": [
        "Closing processes",
        "Reporting accuracy",
        "Management reporting",
        "Data reliability"
       ]
      }
     ]
    },
    {
     "heading": "Operational Audit Reviews",
     "blocks": [
      {
       "type": "p",
       "text": "Operational audits assess whether business processes are efficient and aligned with organisational objectives."
      },
      {
       "type": "p",
       "text": "SHAAS reviews:"
      },
