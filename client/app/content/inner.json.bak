      }
     ]
    },
    {
     "heading": "Why Choose SHAAS?",
     "blocks": []
    },
    {
     "heading": "Strategic Financial Perspective",
     "blocks": [
      {
       "type": "p",
       "text": "We do not simply prepare numbers; we help businesses understand what those numbers mean."
      }
     ]
    },
    {
     "heading": "Business-Focused Planning",
     "blocks": [
