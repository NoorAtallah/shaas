     "heading": "Frequently Asked Questions",
     "blocks": []
    },
    {
     "heading": "What is executive search?",
     "blocks": [
      {
       "type": "p",
       "text": "Executive search is a specialised recruitment approach focused on identifying and attracting senior executives, leaders, and professionals for critical positions."
      }
