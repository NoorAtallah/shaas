    {
     "heading": "Business Valuation Advisory",
     "blocks": [
      {
       "type": "p",
       "text": "Understanding business value is fundamental to successful transactions."
      },
      {
       "type": "p",
       "text": "SHAAS provides valuation support using appropriate methodologies, including:"
      },
      {
       "type": "list",
       "items": [
        "Discounted Cash Flow (DCF)",
        "Market multiples",
        "EBITDA-based valuation approaches",
        "Comparable company analysis"
       ]
      },
      {
       "type": "p",
       "text": "Helping stakeholders understand realistic value expectations."
      }
     ]
    },
    {
     "heading": "Financial Due Diligence Support",
     "blocks": [
      {
       "type": "p",
       "text": "Before completing a transaction, buyers need confidence in the financial position of a target company."
      },
      {
       "type": "p",
       "text": "SHAAS supports financial due diligence through:"
      },
      {
       "type": "list",
       "items": [
        "Historical financial analysis",
        "Revenue quality assessment",
        "Profitability analysis",
        "Working capital review",
        "Cash flow assessment",
        "Financial risk identification"
       ]
      }
     ]
    },
    {
     "heading": "Transaction Modelling",
     "blocks": [
      {
       "type": "p",
       "text": "M&A decisions require detailed financial analysis."
      },
      {
       "type": "p",
       "text": "SHAAS develops transaction models covering:"
      },
      {
       "type": "list",
       "items": [
        "Acquisition scenarios",
        "Funding structures",
        "Return analysis",
        "Synergy opportunities",
        "Post-transaction impact"
       ]
      }
     ]
    },
    {
     "heading": "Deal Structuring Advisory",
     "blocks": [
      {
       "type": "p",
       "text": "Transaction structures can significantly impact value and risk."
      },
      {
       "type": "p",
       "text": "SHAAS supports evaluation of:"
      },
      {
       "type": "list",
       "items": [
        "Acquisition structures",
        "Payment mechanisms",
        "Financing considerations",
        "Deal economics",
        "Value creation opportunities"
       ]
      },
      {
       "type": "p",
       "text": "(Legal structuring requires coordination with qualified legal advisors.)"
      }
     ]
    },
    {
     "heading": "Post-Merger Integration Advisory",
     "blocks": [
