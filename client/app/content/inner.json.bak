    {
     "heading": "Sustainable Business Strategy Advisory",
     "blocks": [
      {
       "type": "p",
       "text": "Sustainability can create competitive advantages when integrated into business strategy."
      },
      {
       "type": "p",
       "text": "SHAAS helps businesses explore:"
      },
      {
       "type": "list",
       "items": [
        "Sustainable growth opportunities",
        "Resource efficiency",
        "Operational improvements",
        "Long-term value creation"
       ]
      }
