    {
     "heading": "Technology & Automation Opportunity Assessment",
     "blocks": [
      {
       "type": "p",
       "text": "Technology can improve operational performance when aligned with business needs."
      },
      {
       "type": "p",
       "text": "SHAAS helps identify opportunities for:"
