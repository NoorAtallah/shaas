    {
     "heading": "What is growth and expansion advisory?",
     "blocks": [
      {
       "type": "p",
       "text": "Growth and expansion advisory helps businesses identify opportunities, develop strategies, and plan the resources required to achieve sustainable growth."
      }
     ]
    },
    {
     "heading": "Why do businesses need growth advisory?",
     "blocks": [
      {
       "type": "p",
       "text": "Growth decisions involve significant investment and risk. Advisory support helps businesses evaluate opportunities and make informed decisions."
