    {
     "heading": "Frequently Asked Questions",
     "blocks": []
    },
    {
     "heading": "What is business process optimisation?",
     "blocks": [
      {
       "type": "p",
       "text": "Business process optimisation is the improvement of business workflows, procedures, and operating methods to increase efficiency, reduce complexity, and improve performance."
      }
     ]
    },
    {
     "heading": "Why do businesses need process optimisation?",
     "blocks": [
      {
       "type": "p",
       "text": "As businesses grow, inefficient processes can increase costs, slow decision-making, and create operational challenges. Optimisation helps businesses operate more effectively."
      }
     ]
    },
    {
     "heading": "Is process optimisation only for large companies?",
     "blocks": [
      {
       "type": "p",
       "text": "No. SMEs and growing businesses often benefit significantly by establishing structured processes before complexity increases."
      }
     ]
    },
    {
     "heading": "How is process optimisation different from business transformation?",
     "blocks": [
      {
       "type": "p",
       "text": "Process optimisation focuses on improving specific workflows and operational activities, while business transformation involves broader changes to the overall business model, strategy, or operating structure."
      }
     ]
    },
    {
     "heading": "Can SHAAS help create SOPs?",
     "blocks": [
      {
       "type": "p",
       "text": "Yes. SHAAS can review existing workflows and support the development of practical SOPs and process documentation."
      }
     ]
    },
    {
     "heading": "Build Efficient Processes That Support Growth",
     "blocks": [
      {
       "type": "p",
       "text": "Efficient businesses are built on clear processes, effective workflows, and strong operational discipline."
      },
      {
       "type": "p",
       "text": "SHAAS helps organisations identify inefficiencies, improve workflows, standardise operations, and build scalable processes that support long-term growth."
      },
      {
       "type": "p",
       "text": "Whether you are experiencing operational complexity, preparing for expansion, or seeking greater efficiency, SHAAS provides the expertise required to optimise how your business operates."
      },
      {
       "type": "p",
       "text": "Contact SHAAS today to discuss how our Business Process Optimisation Services can improve your operational performance."
      }
     ]
    }
