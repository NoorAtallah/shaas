    {
     "heading": "What is compensation and benefits advisory?",
     "blocks": [
      {
       "type": "p",
       "text": "Compensation and benefits advisory helps businesses design employee reward structures that attract talent, improve retention, and align workforce costs with business objectives."
      }
     ]
    },
    {
     "heading": "Why is compensation strategy important?",
     "blocks": [
      {
       "type": "p",
       "text": "A strong compensation strategy helps businesses remain competitive in attracting talent while ensuring fair and sustainable employee rewards."
      }
     ]
    },
    {
     "heading": "How often should companies review compensation?",
     "blocks": [
