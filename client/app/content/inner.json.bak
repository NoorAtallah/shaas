    {
     "heading": "Valuation Methodologies We Consider",
     "blocks": [
      {
       "type": "p",
       "text": "Depending on the purpose and nature of the engagement, SHAAS may consider:"
      }
     ]
    },
    {
     "heading": "Discounted Cash Flow (DCF)",
     "blocks": [
      {
       "type": "p",
       "text": "Assessing business value based on future expected cash flows."
      }
     ]
