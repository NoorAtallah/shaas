    },
    {
     "heading": "Risk-Based Internal Audit Advisory",
     "blocks": [
      {
       "type": "p",
       "text": "A risk-based approach ensures audit efforts focus on areas with the highest business impact."
      },
      {
       "type": "p",
       "text": "SHAAS helps identify:"
      },
