    {
     "heading": "Frequently Asked Questions",
     "blocks": []
    },
    {
     "heading": "What is Business Strategy & Growth Advisory?",
     "blocks": [
      {
       "type": "p",
       "text": "Business Strategy & Growth Advisory helps companies define their strategic direction, identify growth opportunities, improve competitiveness, and develop practical plans to achieve long-term objectives."
      }
     ]
    },
    {
     "heading": "Why does my business need a growth strategy?",
     "blocks": [
      {
       "type": "p",
       "text": "A clear growth strategy helps businesses prioritise opportunities, allocate resources effectively, manage risks, and create sustainable value."
      }
     ]
    },
    {
     "heading": "Is strategy consulting only for large companies?",
     "blocks": [
      {
       "type": "p",
       "text": "No. SMEs and growing businesses often benefit significantly from strategic advisory because decisions made during growth stages can have a major impact on future success."
      }
     ]
    },
    {
     "heading": "Can SHAAS help with market expansion?",
     "blocks": [
      {
       "type": "p",
       "text": "Yes. SHAAS supports businesses evaluating new markets, developing entry strategies, assessing opportunities, and creating expansion roadmaps."
      }
     ]
    },
    {
     "heading": "How is SHAAS different from traditional consultants?",
     "blocks": [
      {
       "type": "p",
       "text": "SHAAS combines strategic advisory with financial and commercial expertise, ensuring recommendations are practical, measurable, and aligned with business performance objectives."
      }
     ]
    },
    {
     "heading": "Turn Your Vision Into a Practical Growth Strategy",
     "blocks": [
      {
       "type": "p",
       "text": "Successful businesses are built through focused decisions, disciplined execution, and continuous improvement."
      },
      {
       "type": "p",
       "text": "SHAAS helps CEOs and business owners define their strategic direction, identify growth opportunities, and build practical roadmaps that support sustainable success."
      },
      {
       "type": "p",
       "text": "Whether you are planning expansion, improving competitiveness, or preparing your business for its next stage of growth, SHAAS provides the strategic insight and practical support required to move forward with confidence."
      },
      {
       "type": "p",
       "text": "Contact SHAAS today to discuss how our Business Strategy & Growth Advisory Services can help your organisation achieve its objectives."
      }
     ]
    }
